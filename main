-- Fluent UI - 0.2s Gojo Farm (JJS Direct Target Fix)
-- Created by @bphong0946

local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Khởi tạo Window Fluent UI
local Window = Fluent:CreateWindow({
    Title = "0.2s Gojo Farm | @bphong0946",
    SubTitle = "⚡ JJS Direct Target - Fluent Edition",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 400),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.K 
})

-- Tạo Tab chính
local Tabs = {
    Farm = Window:AddTab({ Title = "Gojo Farm", Icon = "swords" }),
    Settings = Window:AddTab({ Title = "Settings", Icon = "settings" })
}

-- Biến điều khiển trạng thái
local isFarmActive = false
local tpOffset = 3 -- Độ cao đứng trên đầu mục tiêu
local lastSwitchTime = 0
local switchInterval = 1 -- Thời gian đổi người chơi (giây)
local currentIndex = 1

-- Hàm quét lấy tất cả người chơi trong JJS (bỏ qua bản thân)
local function getJJSPlayers()
    local list = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            -- Chỉ cần có Character và HumanoidRootPart là tóm luôn, không lọc máu rườm rà
            if player.Character:FindFirstChild("HumanoidRootPart") then
                table.insert(list, player)
            end
        end
    end
    return list
end

-- ==========================================
-- GIAO DIỆN TAB FARM
-- ==========================================
Tabs.Farm:AddParagraph({
    Title = "Trạng thái Auto Farm (JJS Mode)",
    Content = "Đã tối ưu hóa riêng cho JJS. Tự động xoay vòng dịch chuyển sang người khác mỗi 1 giây để tích dame."
})

-- Toggle Bật/Tắt Farm
Tabs.Farm:AddToggle("GojoRotateToggle", {
    Title = "Bật/Tắt Teleport Farm",
    Default = false,
    Callback = function(Value)
        isFarmActive = Value
        if not isFarmActive then
            pcall(function()
                local char = LocalPlayer.Character
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
            end)
        end
    end
})

-- Slider tùy chỉnh thời gian đổi người chơi
Tabs.Farm:AddSlider("IntervalSlider", {
    Title = "Thời gian đổi mục tiêu (Giây)",
    Description = "Chỉnh số giây để dịch chuyển sang người tiếp theo",
    Default = 1,
    Min = 0.5,
    Max = 5,
    Rounding = 1,
    Callback = function(Value)
        switchInterval = Value
    end
})

-- Slider tùy chỉnh độ cao TP so với đầu mục tiêu
Tabs.Farm:AddSlider("TPOffsetSlider", {
    Title = "Độ cao dịch chuyển (Offset Y)",
    Description = "Chỉnh khoảng cách đứng trên đầu mục tiêu",
    Default = 3,
    Min = 0,
    Max = 10,
    Rounding = 0,
    Callback = function(Value)
        tpOffset = Value
    end
})

-- ==========================================
-- LOGIC XỬ LÝ DỊCH CHUYỂN TRỰC TIẾP TRONG JJS
-- ==========================================
RunService.RenderStepped:Connect(function()
    if not isFarmActive then return end
    
    pcall(function()
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local rootPart = char.HumanoidRootPart

        local targets = getJJSPlayers()
        if #targets > 0 then
            -- Chuyển đổi mục tiêu theo thời gian cài đặt
            if tick() - lastSwitchTime >= switchInterval then
                lastSwitchTime = tick()
                currentIndex = currentIndex + 1
                if currentIndex > #targets then
                    currentIndex = 1
                end
            end

            if currentIndex > #targets then currentIndex = 1 end
            local targetPlayer = targets[currentIndex]

            if targetPlayer and targetPlayer.Character then
                local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                if targetRoot then
                    -- Tắt va chạm phụ để không bị game đẩy văng
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                            part.CanCollide = false
                        end
                    end

                    -- Triệt tiêu quán tính vật lý
                    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

                    -- Dịch chuyển trực tiếp bám lên đầu mục tiêu
                    local targetCFrame = targetRoot.CFrame + Vector3.new(0, tpOffset, 0)
                    char:PivotTo(CFrame.new(targetCFrame.Position) * rootPart.CFrame.Rotation)
                end
            end
        end
    end)
end)

Window:SelectTab(1)
Fluent:Notify({
    Title = "0.2s Gojo Farm",
    Content = "Đã cập nhật chế độ tương thích trực tiếp với JJS!",
    Duration = 4
})
