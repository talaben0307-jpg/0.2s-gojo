-- Fluent UI - 0.2s Gojo Farm (Fixed Teleport & Stable Hitbox)
-- Created by @bphong0946

local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Khởi tạo Window Fluent UI
local Window = Fluent:CreateWindow({
    Title = "0.2s Gojo Farm | @bphong0946",
    SubTitle = "⚡ 1s Teleport Rotate - Fluent Edition",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 400),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.K 
})

-- Tạo Tab chính
local Tabs = {
    Farm = Window:AddTab({ Title = "Gojo Farm", Icon = "swords" }),
    Settings = Window:AddTab({ Title = "Settings", Icon = "settings" })
}

-- Biến điều khiển trạng thái
local isFarmActive = false
local tpOffset = 3 -- Độ cao đứng trên đầu mục tiêu
local playerList = {}
local currentIndex = 1
local lastSwitchTime = 0
local switchInterval = 1 -- Mặc định 1 giây đổi 1 người

-- Hàm lấy danh sách toàn bộ người chơi còn sống (trừ bản thân)
local function getActivePlayers()
    local list = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                table.insert(list, player)
            end
        end
    end
    return list
end

-- ==========================================
-- GIAO DIỆN TAB FARM
-- ==========================================
Tabs.Farm:AddParagraph({
    Title = "Trạng thái Auto Farm (1 giây dịch chuyển 1 người)",
    Content = "Mỗi giây script sẽ tự động dịch chuyển thẳng tới một người chơi khác để tích sát thương liên tục."
})

-- Toggle Bật/Tắt Farm
Tabs.Farm:AddToggle("GojoRotateToggle", {
    Title = "Bật/Tắt 1s Teleport Farm",
    Default = false,
    Callback = function(Value)
        isFarmActive = Value
        if not isFarmActive then
            playerList = {}
            currentIndex = 1
            -- Bật lại va chạm bình thường khi tắt script
            pcall(function()
                local char = LocalPlayer.Character
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
            end)
        end
    end
})

-- Slider tùy chỉnh thời gian đổi người chơi (mặc định 1 giây)
Tabs.Farm:AddSlider("IntervalSlider", {
    Title = "Thời gian đổi mục tiêu (Giây)",
    Description = "Chỉnh số giây để dịch chuyển sang người tiếp theo",
    Default = 1,
    Min = 0.5,
    Max = 5,
    Rounding = 1,
    Callback = function(Value)
        switchInterval = Value
    end
})

-- Slider tùy chỉnh độ cao TP so với đầu mục tiêu
Tabs.Farm:AddSlider("TPOffsetSlider", {
    Title = "Độ cao dịch chuyển (Offset Y)",
    Description = "Chỉnh khoảng cách đứng trên đầu mục tiêu",
    Default = 3,
    Min = 0,
    Max = 10,
    Rounding = 0,
    Callback = function(Value)
        tpOffset = Value
    end
})

-- ==========================================
-- LOGIC XỬ LÝ DỊCH CHUYỂN MỖI 1 GIÂY (FIX LỖI HITBOX)
-- ==========================================
RunService.RenderStepped:Connect(function()
    if not isFarmActive then return end
    
    pcall(function()
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local rootPart = char.HumanoidRootPart

        -- Kiểm tra xem đã đến thời điểm đổi người chơi chưa (mỗi 1 giây)
        if tick() - lastSwitchTime >= switchInterval then
            lastSwitchTime = tick()
            playerList = getActivePlayers()
            if #playerList > 0 then
                currentIndex = currentIndex + 1
                if currentIndex > #playerList then
                    currentIndex = 1
                end
                
                -- Lấy mục tiêu mới theo danh sách
                local targetPlayer = playerList[currentIndex]
                if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local targetRoot = targetPlayer.Character.HumanoidRootPart
                    
                    -- Tắt va chạm phụ để không bị game đẩy văng ra ngoài
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                            part.CanCollide = false
                        end
                    end

                    -- Triệt tiêu lực quán tính vật lý
                    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

                    -- Dịch chuyển trực tiếp đến đầu mục tiêu ngay khi đến mốc thời gian
                    local targetCFrame = targetRoot.CFrame + Vector3.new(0, tpOffset, 0)
                    char:PivotTo(CFrame.new(targetCFrame.Position) * rootPart.CFrame.Rotation)
                end
            else
                -- Nếu không còn ai sống, quét lại danh sách
                playerList = getActivePlayers()
                currentIndex = 1
            end
        end
    end)
end)

-- Hoàn tất cài đặt giao diện
Window:SelectTab(1)
Fluent:Notify({
    Title = "0.2s Gojo Farm",
    Content = "Đã cập nhật chế độ 1s Teleport dính chặt Hitbox!",
    Duration = 4
})
