-- Fluent UI - 0.2 Gojo Farm (Rotate Every 1 Second for Damage)
-- Created by @bphong0946

local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Khởi tạo Window Fluent UI
local Window = Fluent:CreateWindow({
    Title = "0.2 Gojo Farm | @bphong0946",
    SubTitle = "⚡ Rotate Every 1s (Damage Farming) - Fluent Edition",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 400),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.K 
})

-- Tạo Tab chính
local Tabs = {
    Farm = Window:AddTab({ Title = "Gojo Rotate Farm", Icon = "swords" }),
    Settings = Window:AddTab({ Title = "Settings", Icon = "settings" })
}

-- Biến điều khiển trạng thái
local isFarmActive = false
local tpOffset = 3 -- Khoảng cách dịch chuyển trên đầu mục tiêu
local playerList = {}
local currentIndex = 1
local lastSwitchTime = 0
local switchInterval = 1 -- Thời gian đổi người chơi (1 giây)

-- Hàm lấy danh sách tất cả người chơi còn sống (trừ bản thân)
local function getActivePlayers()
    local list = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                table.insert(list, player)
            end
        end
    end
    return list
end

-- ==========================================
-- GIAO DIỆN TAB FARM
-- ==========================================
Tabs.Farm:AddParagraph({
    Title = "Trạng thái Auto Farm (Đổi mục tiêu mỗi 1 giây)",
    Content = "Mỗi giây script sẽ tự động nhảy sang một người chơi khác trong server để tích x dame liên tục."
})

-- Toggle Bật/Tắt Farm
Tabs.Farm:AddToggle("GojoRotateToggle", {
    Title = "Bật/Tắt Rotate Farm (1s/lần)",
    Default = false,
    Callback = function(Value)
        isFarmActive = Value
        if not isFarmActive then
            playerList = {}
            currentIndex = 1
            pcall(function()
                local char = LocalPlayer.Character
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
            end)
        end
    end
})

-- Slider tùy chỉnh thời gian đổi người chơi (mặc định 1 giây)
Tabs.Farm:AddSlider("IntervalSlider", {
    Title = "Thời gian đổi mục tiêu (Giây)",
    Description = "Chỉnh số giây để nhảy sang người tiếp theo",
    Default = 1,
    Min = 0.5,
    Max = 5,
    Rounding = 1,
    Callback = function(Value)
        switchInterval = Value
    end
})

-- Slider tùy chỉnh độ cao TP so với đầu mục tiêu
Tabs.Farm:AddSlider("TPOffsetSlider", {
    Title = "Độ cao dịch chuyển (Offset Y)",
    Description = "Chỉnh khoảng cách đứng trên đầu mục tiêu",
    Default = 3,
    Min = 0,
    Max = 10,
    Rounding = 0,
    Callback = function(Value)
        tpOffset = Value
    end
})

-- ==========================================
-- LOGIC XỬ LÝ XOAY VÒNG MỤC TIÊU MỖI X GIÂY
-- ==========================================
RunService.RenderStepped:Connect(function()
    if not isFarmActive then return end
    
    pcall(function()
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local rootPart = char.HumanoidRootPart

        -- Kiểm tra xem đã đến lúc đổi người chơi chưa
        if tick() - lastSwitchTime >= switchInterval then
            lastSwitchTime = tick()
            playerList = getActivePlayers()
            if #playerList > 0 then
                currentIndex = currentIndex + 1
                if currentIndex > #playerList then
                    currentIndex = 1
                end
            else
                currentIndex = 0
            end
        end

        -- Lấy mục tiêu hiện tại theo danh sách xoay vòng
        local targetPlayer = nil
        if #playerList > 0 and currentIndex > 0 and currentIndex <= #playerList then
            targetPlayer = playerList[currentIndex]
        else
            -- Nếu danh sách trống, quét lại từ đầu
            playerList = getActivePlayers()
            if #playerList > 0 then
                currentIndex = 1
                targetPlayer = playerList[1]
            end
        end

        -- Nếu có mục tiêu hợp lệ, dịch chuyển bám sát
        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local targetRoot = targetPlayer.Character.HumanoidRootPart
            
            -- Tắt va chạm phụ để không bị kẹt/văng
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.CanCollide = false
                end
            end

            -- Triệt tiêu quán tính vật lý
            rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

            -- Dùng PivotTo để bám dính mục tiêu hiện tại mà không làm giật màn hình camera
            local targetCFrame = targetRoot.CFrame + Vector3.new(0, tpOffset, 0)
            char:PivotTo(CFrame.new(targetCFrame.Position) * rootPart.CFrame.Rotation)
        end
    end)
end)

-- Hoàn tất cài đặt giao diện
Window:SelectTab(1)
Fluent:Notify({
    Title = "0.2 Gojo Farm",
    Content = "Đã cấu hình chế độ xoay vòng mục tiêu để tích dame!",
    Duration = 4
})
