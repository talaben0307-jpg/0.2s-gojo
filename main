-- Fluent UI - 0.2 Gojo Farm (Fixed Camera / No Screen Shake)
-- Created by @bphong0946

local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Khởi tạo Window Fluent UI
local Window = Fluent:CreateWindow({
    Title = "0.2 Gojo Farm | @bphong0946",
    SubTitle = "⚡ Stable TP (No Camera Shake) - Fluent Edition",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 400),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.K 
})

-- Tạo Tab chính
local Tabs = {
    Farm = Window:AddTab({ Title = "Gojo Direct Farm", Icon = "swords" }),
    Settings = Window:AddTab({ Title = "Settings", Icon = "settings" })
}

-- Biến điều khiển trạng thái
local isFarmActive = false
local currentTarget = nil
local tpOffset = 3 -- Khoảng cách dịch chuyển trên đầu mục tiêu

-- Hàm tìm kiếm người chơi tiếp theo còn sống
local function getNextTarget()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                return player
            end
        end
    end
    return nil
end

-- ==========================================
-- GIAO DIỆN TAB FARM
-- ==========================================
Tabs.Farm:AddParagraph({
    Title = "Trạng thái Auto Farm (Đã chống văng màn hình)",
    Content = "Bám chặt mục tiêu mà không làm ảnh hưởng đến góc nhìn camera của bạn."
})

-- Toggle Bật/Tắt Farm
Tabs.Farm:AddToggle("GojoDirectToggle", {
    Title = "Bật/Tắt Gojo Direct Farm",
    Default = false,
    Callback = function(Value)
        isFarmActive = Value
        if not isFarmActive then
            currentTarget = nil
            pcall(function()
                local char = LocalPlayer.Character
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
            end)
        end
    end
})

-- Slider tùy chỉnh độ cao TP so với đầu mục tiêu
Tabs.Farm:AddSlider("TPOffsetSlider", {
    Title = "Độ cao dịch chuyển (Offset Y)",
    Description = "Chỉnh khoảng cách đứng trên đầu mục tiêu",
    Default = 3,
    Min = 0,
    Max = 10,
    Rounding = 0,
    Callback = function(Value)
        tpOffset = Value
    end
})

-- ==========================================
-- LOGIC XỬ LÝ TELEPORT ỔN ĐỊNH (KHÔNG GIẬT CAMERA)
-- ==========================================
RunService.RenderStepped:Connect(function()
    if not isFarmActive then return end
    
    pcall(function()
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local rootPart = char.HumanoidRootPart

        -- Kiểm tra xem mục tiêu hiện tại có còn sống không
        local isValidTarget = false
        if currentTarget and currentTarget.Character then
            local humanoid = currentTarget.Character:FindFirstChildOfClass("Humanoid")
            local targetRoot = currentTarget.Character:FindFirstChild("HumanoidRootPart")
            if humanoid and humanoid.Health > 0 and targetRoot then
                isValidTarget = true
            end
        end

        -- Nếu mục tiêu chết hoặc chưa có, tìm người mới
        if not isValidTarget then
            currentTarget = getNextTarget()
        end

        -- Nếu có mục tiêu hợp lệ, dịch chuyển mượt mà bằng PivotTo
        if currentTarget and currentTarget.Character and currentTarget.Character:FindFirstChild("HumanoidRootPart") then
            local targetRoot = currentTarget.Character.HumanoidRootPart
            
            -- Tắt va chạm phụ để không bị đẩy văng
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.CanCollide = false
                end
            end

            -- Triệt tiêu quán tính vật lý
            rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

            -- Dùng PivotTo để dời nhân vật theo vị trí đối thủ nhưng giữ nguyên góc xoay/hướng nhìn hiện tại của bạn
            local targetCFrame = targetRoot.CFrame + Vector3.new(0, tpOffset, 0)
            char:PivotTo(CFrame.new(targetCFrame.Position) * rootPart.CFrame.Rotation)
        end
    end)
end)

-- Hoàn tất cài đặt giao diện
Window:SelectTab(1)
Fluent:Notify({
    Title = "0.2 Gojo Farm",
    Content = "Đã khóa lỗi văng màn hình thành công!",
    Duration = 4
})
