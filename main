-- Fluent UI - 0.2s Gojo Farm (Offset Front/Side Lock)
-- Created by @bphong0946

local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Khởi tạo Window Fluent UI
local Window = Fluent:CreateWindow({
    Title = "0.2s Gojo Farm | @bphong0946",
    SubTitle = "⚡ Close Combat Lock - Fluent Edition",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 400),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.K 
})

-- Tạo Tab chính
local Tabs = {
    Farm = Window:AddTab({ Title = "Gojo Farm", Icon = "swords" }),
    Settings = Window:AddTab({ Title = "Settings", Icon = "settings" })
}

-- Biến điều khiển trạng thái
local isFarmActive = false
local tpDistance = 2 -- Khoảng cách cách mục tiêu (mặc định 2 stud)
local tpHeight = 0   -- Độ cao so với mục tiêu (ngang tầm hoặc thấp hơn chút)
local currentTarget = nil

-- Hàm tìm người chơi gần nhất trong JJS để bám chặt
local function getClosestPlayer()
    local closestTarget = nil
    local shortestDistance = math.huge
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            
            if root and localRoot then
                local distance = (root.Position - localRoot.Position).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closestTarget = player
                end
            end
        end
    end
    return closestTarget
end

-- ==========================================
-- GIAO DIỆN TAB FARM
-- ==========================================
Tabs.Farm:AddParagraph({
    Title = "Trạng thái Auto Farm (Cận chiến 1-2 stud)",
    Content = "Khóa chặt và đứng cách mục tiêu một khoảng cố định phía trước/ngang tầm để đánh trúng liên tục."
})

-- Toggle Bật/Tătă Farm
Tabs.Farm:AddToggle("GojoRotateToggle", {
    Title = "Bật/Tắt Combat Lock",
    Default = false,
    Callback = function(Value)
        isFarmActive = Value
        if not isFarmActive then
            currentTarget = nil
            pcall(function()
                local char = LocalPlayer.Character
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
            end)
        end
    end
})

-- Slider tùy chỉnh khoảng cách cách mục tiêu (1-5 stud)
Tabs.Farm:AddSlider("DistanceSlider", {
    Title = "Khoảng cách cách mục tiêu (Studs)",
    Description = "Chỉnh khoảng cách đứng gần mục tiêu (1 đến 5 stud)",
    Default = 2,
    Min = 1,
    Max = 5,
    Rounding = 1,
    Callback = function(Value)
        tpDistance = Value
    end
})

-- Slider tùy chỉnh độ cao (Offset Y)
Tabs.Farm:AddSlider("HeightSlider", {
    Title = "Độ cao so với mục tiêu (Offset Y)",
    Description = "Chỉnh cao hoặc thấp hơn mục tiêu",
    Default = 0,
    Min = -2,
    Max = 5,
    Rounding = 1,
    Callback = function(Value)
        tpHeight = Value
    end
})

-- ==========================================
-- LOGIC BÁM DÍNH CẬN CHIẾN MỖI FRAME
-- ==========================================
RunService.RenderStepped:Connect(function()
    if not isFarmActive then return end
    
    pcall(function()
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local rootPart = char.HumanoidRootPart

        -- Kiểm tra mục tiêu hiện tại, nếu mất thì tìm người gần nhất
        if not currentTarget or not currentTarget.Character or not currentTarget.Character:FindFirstChild("HumanoidRootPart") then
            currentTarget = getClosestPlayer()
        end

        if currentTarget and currentTarget.Character then
            local targetRoot = currentTarget.Character:FindFirstChild("HumanoidRootPart")
            if targetRoot then
                -- Tắt va chạm phụ để không bị game đẩy văng
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        part.CanCollide = false
                    end
                end

                -- Triệt tiêu quán tính vật lý
                rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

                -- Tính toán vị trí: Đứng trước mặt mục tiêu một khoảng `tpDistance` và nhìn thẳng vào họ
                local targetCFrame = targetRoot.CFrame
                local offsetPosition = targetCFrame.Position + (targetCFrame.LookVector * tpDistance) + Vector3.new(0, tpHeight, 0)
                
                -- Khóa vị trí nhưng giữ góc nhìn hoặc hướng về phía mục tiêu
                char:PivotTo(CFrame.new(offsetPosition, targetCFrame.Position + Vector3.new(0, tpHeight, 0)))
            end
        end
    end)
end)

Window:SelectTab(1)
Fluent:Notify({
    Title = "0.2s Gojo Farm",
    Content = "Đã cấu hình bám sát cận chiến 1-2 stud!",
    Duration = 4
})
