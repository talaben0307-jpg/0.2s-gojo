-- Fluent UI - 0.2 Gojo Farm with Orbit Teleport
-- Created by @bphong0946

local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Khởi tạo Window Fluent UI
local Window = Fluent:CreateWindow({
    Title = "0.2 Gojo Farm | @bphong0946",
    SubTitle = "⚡ Orbit Farm - Fluent Edition",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 420),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.K -- Phím ẩn/hiện menu
})

-- Tạo Tab chính
local Tabs = {
    Farm = Window:AddTab({ Title = "Gojo Orbit Farm", Icon = "swords" }),
    Settings = Window:AddTab({ Title = "Settings", Icon = "settings" })
}

local Options = Fluent.Options

-- Biến điều khiển trạng thái và cấu hình Orbit
local isFarmActive = false
local currentTarget = nil
local orbitSpeed = 3
local orbitRadius = 6
local angle = 0

-- Hàm tìm kiếm người chơi tiếp theo còn sống
local function getNextTarget()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                return player
            end
        end
    end
    return nil
end

-- ==========================================
-- GIAO DIỆN TAB FARM
-- ==========================================
Tabs.Farm:AddParagraph({
    Title = "Trạng thái Auto Farm",
    Content = "Bật tính năng để nhân vật tự động bay lượn vòng tròn (Orbit) quanh mục tiêu còn sống và tự đổi người chơi khi mục tiêu chết."
})

-- Toggle Bật/Tắt Farm
Tabs.Farm:AddToggle("GojoOrbitToggle", {
    Title = "Bật/Tắt Gojo Orbit Farm",
    Default = false,
    Callback = function(Value)
        isFarmActive = Value
        if not isFarmActive then
            currentTarget = nil
        end
    end
})

-- Slider tùy chỉnh tốc độ xoay vòng (Orbit Speed)
Tabs.Farm:AddSlider("OrbitSpeedSlider", {
    Title = "Tốc độ xoay (Orbit Speed)",
    Description = "Chỉnh tốc độ bay lượn vòng tròn",
    Default = 3,
    Min = 1,
    Max = 10,
    Rounding = 1,
    Callback = function(Value)
        orbitSpeed = Value
    end
})

-- Slider tùy chỉnh bán kính vòng xoay
Tabs.Farm:AddSlider("OrbitRadiusSlider", {
    Title = "Khoảng cách xoay (Radius)",
    Description = "Chỉnh bán kính vòng xoay quanh mục tiêu",
    Default = 6,
    Min = 2,
    Max = 15,
    Rounding = 0,
    Callback = function(Value)
        orbitRadius = Value
    end
})

-- ==========================================
-- LOGIC XỬ LÝ QUỸ ĐẠO ORBIT & AUTO TARGET
-- ==========================================
RunService.RenderStepped:Connect(function(dt)
    if not isFarmActive then return end
    
    pcall(function()
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local rootPart = char.HumanoidRootPart

        -- Kiểm tra xem mục tiêu hiện tại có còn sống không
        local isValidTarget = false
        if currentTarget and currentTarget.Character then
            local humanoid = currentTarget.Character:FindFirstChildOfClass("Humanoid")
            local targetRoot = currentTarget.Character:FindFirstChild("HumanoidRootPart")
            if humanoid and humanoid.Health > 0 and targetRoot then
                isValidTarget = true
            end
        end

        -- Nếu mục tiêu chết hoặc chưa có, tìm người mới
        if not isValidTarget then
            currentTarget = getNextTarget()
        end

        -- Nếu có mục tiêu hợp lệ, tính toán tọa độ xoay vòng quanh họ
        if currentTarget and currentTarget.Character and currentTarget.Character:FindFirstChild("HumanoidRootPart") then
            local targetRoot = currentTarget.Character.HumanoidRootPart
            
            -- Tăng góc quay theo thời gian thực và tốc độ cấu hình
            angle = angle + (dt * orbitSpeed)
            
            -- Công thức lượng giác tính tọa độ vòng tròn quanh nhân vật mục tiêu
            local offsetX = math.cos(angle) * orbitRadius
            local offsetZ = math.sin(angle) * orbitRadius
            
            -- Đặt vị trí mới xoay quanh mục tiêu (bay cao hơn 2 đơn vị so với tâm người chơi)
            local targetPos = targetRoot.Position + Vector3.new(offsetX, 2, offsetZ)
            
            -- Cập nhật CFrame để vừa xoay vòng vừa nhìn thẳng vào mục tiêu
            rootPart.CFrame = CFrame.new(targetPos, targetRoot.Position)
        end
    end)
end)

-- Hoàn tất cài đặt giao diện
Window:SelectTab(1)
Fluent:Notify({
    Title = "0.2 Gojo Farm",
    Content = "Đã tải thành công giao diện Fluent UI!",
    Duration = 4
})
