-- Fluent UI - 0.2s Gojo Farm (Continuous Lock Target)
-- Created by @bphong0946

local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Khởi tạo Window Fluent UI
local Window = Fluent:CreateWindow({
    Title = "0.2s Gojo Farm | @bphong0946",
    SubTitle = "⚡ Continuous Lock - Fluent Edition",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 400),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.K 
})

-- Tạo Tab chính
local Tabs = {
    Farm = Window:AddTab({ Title = "Gojo Farm", Icon = "swords" }),
    Settings = Window:AddTab({ Title = "Settings", Icon = "settings" })
}

-- Biến điều khiển trạng thái
local isFarmActive = false
local tpOffset = 3 -- Độ cao đứng trên đầu mục tiêu
local currentTarget = nil

-- Hàm tìm người chơi gần nhất trong JJS để bám chặt
local function getClosestPlayer()
    local closestTarget = nil
    local shortestDistance = math.huge
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            
            if root and localRoot then
                local distance = (root.Position - localRoot.Position).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closestTarget = player
                end
            end
        end
    end
    return closestTarget
end

-- ==========================================
-- GIAO DIỆN TAB FARM
-- ==========================================
Tabs.Farm:AddParagraph({
    Title = "Trạng thái Auto Farm (Bám dính liên tục)",
    Content = "Đã bỏ cơ chế đổi người mỗi giây. Nhân vật sẽ khóa chặt và bám dính liên tục vào mục tiêu để tấn công mượt mà."
})

-- Toggle Bật/Tắt Farm
Tabs.Farm:AddToggle("GojoRotateToggle", {
    Title = "Bật/Tắt Continuous Farm",
    Default = false,
    Callback = function(Value)
        isFarmActive = Value
        if not isFarmActive then
            currentTarget = nil
            pcall(function()
                local char = LocalPlayer.Character
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
            end)
        end
    end
})

-- Slider tùy chỉnh độ cao TP so với đầu mục tiêu
Tabs.Farm:AddSlider("TPOffsetSlider", {
    Title = "Độ cao dịch chuyển (Offset Y)",
    Description = "Chỉnh khoảng cách đứng trên đầu mục tiêu",
    Default = 3,
    Min = 0,
    Max = 10,
    Rounding = 0,
    Callback = function(Value)
        tpOffset = Value
    end
})

-- ==========================================
-- LOGIC BÁM DÍNH LIÊN TỤC MỖI FRAME
-- ==========================================
RunService.RenderStepped:Connect(function()
    if not isFarmActive then return end
    
    pcall(function()
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local rootPart = char.HumanoidRootPart

        -- Kiểm tra mục tiêu hiện tại còn tồn tại không, nếu không thì tìm người gần nhất
        if not currentTarget or not currentTarget.Character or not currentTarget.Character:FindFirstChild("HumanoidRootPart") then
            currentTarget = getClosestPlayer()
        end

        if currentTarget and currentTarget.Character then
            local targetRoot = currentTarget.Character:FindFirstChild("HumanoidRootPart")
            if targetRoot then
                -- Tắt va chạm phụ để không bị game đẩy văng
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        part.CanCollide = false
                    end
                end

                -- Triệt tiêu quán tính vật lý tránh trượt vị trí
                rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

                -- Khóa chặt vị trí liên tục trên đầu mục tiêu, giữ nguyên góc nhìn camera
                local targetCFrame = targetRoot.CFrame + Vector3.new(0, tpOffset, 0)
                char:PivotTo(CFrame.new(targetCFrame.Position) * rootPart.CFrame.Rotation)
            end
        end
    end)
end)

Window:SelectTab(1)
Fluent:Notify({
    Title = "0.2s Gojo Farm",
    Content = "Đã chuyển sang chế độ bám dính liên tục thành công!",
    Duration = 4
})
