-- Fluent UI - Gojo Target Lock Farm (Kill & Switch to Nearest)
-- Created by @bphong0946

local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Khởi tạo Window Fluent UI
local Window = Fluent:CreateWindow({
    Title = "0.2s Gojo Farm | @bphong0946",
    SubTitle = "⚡ Target Lock & Auto Switch - Fluent Edition",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 400),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.K 
})

-- Tạo Tab chính
local Tabs = {
    Farm = Window:AddTab({ Title = "Gojo Farm", Icon = "swords" }),
    Settings = Window:AddTab({ Title = "Settings", Icon = "settings" })
}

-- Biến điều khiển trạng thái
local isFarmActive = false
local tpOffset = 3 -- Độ cao đứng trên đầu mục tiêu
local currentTarget = nil

-- Hàm tìm người chơi sống gần nhất còn tồn tại HumanoidRootPart
local function getClosestTarget()
    local closestPlayer = nil
    local shortestDistance = math.huge
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local rootPos = char.HumanoidRootPart.Position

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if targetRoot and humanoid and humanoid.Health > 0 then
                local distance = (targetRoot.Position - rootPos).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closestPlayer = player
                end
            end
        end
    end
    return closestPlayer
end

-- ==========================================
-- GIAO DIỆN TAB FARM
-- ==========================================
Tabs.Farm:AddParagraph({
    Title = "Trạng thái Auto Farm (Bám dính & Đổi mục tiêu khi chết)",
    Content = "Tự động khóa và bám dính 1 người cho đến khi họ chết, sau đó tự động chuyển sang người gần nhất tiếp theo."
})

-- Toggle Bật/Tắt Farm
Tabs.Farm:AddToggle("GojoLockToggle", {
    Title = "Bật/Tắt Target Lock Farm",
    Default = false,
    Callback = function(Value)
        isFarmActive = Value
        if not isFarmActive then
            currentTarget = nil
            pcall(function()
                local char = LocalPlayer.Character
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
            end)
        end
    end
})

-- Slider tùy chỉnh độ cao TP so với đầu mục tiêu
Tabs.Farm:AddSlider("TPOffsetSlider", {
    Title = "Độ cao dịch chuyển (Offset Y)",
    Description = "Chỉnh khoảng cách đứng trên đầu mục tiêu",
    Default = 3,
    Min = 0,
    Max = 10,
    Rounding = 0,
    Callback = function(Value)
        tpOffset = Value
    end
})

-- ==========================================
-- LOGIC BÁM DÍNH VÀ TỰ ĐỘNG ĐỔI KHI MỤC TIÊU CHẾT
-- ==========================================
RunService.RenderStepped:Connect(function()
    if not isFarmActive then return end
    
    pcall(function()
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local rootPart = char.HumanoidRootPart

        -- Kiểm tra nếu mục tiêu hiện tại đã chết, mất character hoặc thoát game -> tìm mục tiêu gần nhất mới ngay lập tức
        local needsNewTarget = false
        if not currentTarget or not currentTarget.Character then
            needsNewTarget = true
        else
            local humanoid = currentTarget.Character:FindFirstChildOfClass("Humanoid")
            local targetRoot = currentTarget.Character:FindFirstChild("HumanoidRootPart")
            if not humanoid or humanoid.Health <= 0 or not targetRoot then
                needsNewTarget = true
            end
        end

        if needsNewTarget then
            currentTarget = getClosestTarget()
        end

        -- Nếu có mục tiêu hợp lệ, bám dính chặt liên tục từng frame trên đầu họ
        if currentTarget and currentTarget.Character then
            local targetRoot = currentTarget.Character:FindFirstChild("HumanoidRootPart")
            if targetRoot then
                -- Tắt va chạm phụ để không bị game đẩy văng
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        part.CanCollide = false
                    end
                end

                -- Triệt tiêu quán tính vật lý
                rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

                -- Dịch chuyển bám sát đỉnh đầu mục tiêu
                local targetCFrame = targetRoot.CFrame + Vector3.new(0, tpOffset, 0)
                char:PivotTo(CFrame.new(targetCFrame.Position) * rootPart.CFrame.Rotation)
            end
        end
    end)
end)

Window:SelectTab(1)
Fluent:Notify({
    Title = "0.2s Gojo Farm",
    Content = "Đã cập nhật chế độ Target Lock & Auto Switch chuẩn xác!",
    Duration = 4
})
